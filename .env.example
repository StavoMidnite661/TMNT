# Shells in the Shadows: Back Alley Tales
# Copy to .env.local and fill in values.

# Required for AI-generated cutscene dialogue (Google AI Studio / Gemini API).
GEMINI_API_KEY=

# Optional: override the Gemini model used for dialogue generation.
GEMINI_MODEL=gemini-3-flash-preview

# Optional: port the server listens on (default 3000).
PORT=3000

# Optional: public URL where the app is hosted.
APP_URL=
